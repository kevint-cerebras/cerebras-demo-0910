# Required for live agent execution. Keep the actual key in .env.
CEREBRAS_API_KEY=
# Set to the exact model ID supplied with your key.
CEREBRAS_MODEL=qwen-3.8-27b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/qwen3p8-27b
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
INFERENCE_PROVIDER=cerebras
DEMO_MODE=marketplace
# Private, local-only Amazon constraints. Never commit the populated value.
AMAZON_EPHEMERAL_BRIEF=
PORT=3100

# Headless workers are the default. Set false for an optional visible Chromium window.
# The browser remains visible and interactive in Dash's live preview.
BROWSER_HEADLESS=true
BROWSER_CHANNEL=chrome
# Optional absolute Chromium/Chrome binary path.
# BROWSER_EXECUTABLE_PATH=
