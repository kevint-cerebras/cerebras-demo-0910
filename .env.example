# Optional. Without credentials Dash runs its clearly labeled local planner.
CEREBRAS_API_KEY=
# Set to the exact model ID supplied with your key.
CEREBRAS_MODEL=
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
PORT=3100

# Set true only for unattended headless benchmarks. Normal demos use visible Chromium.
BROWSER_HEADLESS=false
